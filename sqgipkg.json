{
  "schema_version": 2,
  "name": "RFDTool",
  "app_id": "com.github.supercamel.rfdtool",
  "icon": "images/com.github.supercamel.rfdtool.png",
  "desktop_categories": [
    "Utility",
    "GTK"
  ],
  "script": "main.nut",
  "runtime": {
    "sqgi": "3a561e5bc4429283c39380898133f747cc26206f"
  },
  "features": [
    "gtk4"
  ],
  "native": [
    {
      "name": "gserial",
      "repo": "https://github.com/supercamel/gserial.git",
      "gi": {
        "strategy": "host",
        "namespace": "GSerial",
        "version": "1.0",
        "library": "gserial-1.0"
      },
      "ref": "d9bfcbcd59b43ba9bdbdc055fc928261efdb3562",
      "dir": ".sqgipkg/native/gserial-0.3"
    }
  ],
  "platforms": {
    "linux": {
      "architectures": [
        "x86_64",
        "aarch64"
      ],
      "baseline": "ubuntu-22.04"
    },
    "windows": {
      "architectures": [
        "x86_64"
      ],
      "format": "installer"
    },
    "android": {
      "architectures": [
        "arm64-v8a",
        "x86_64"
      ],
      "sdk": "noble-android-r4",
      "min_sdk": 31,
      "version_code": 25,
      "version_name": "0.0.25-alpha",
      "variant": "debug",
      "namespaces": [
        "Gtk-4.0",
        "GSerial-1.0"
      ],
      "native": [
        {
          "name": "gserial",
          "options": {
            "android_test_backend": false
          },
          "gi": {
            "strategy": "target"
          }
        }
      ],
      "runtime": "package"
    }
  },
  "linux": {
    "packages": [
      "libgirepository-1.0-1",
      "libharfbuzz-gobject0"
    ]
  },
  "windows": {
    "files": [
      "images/com.github.supercamel.rfdtool.png=share/icons/hicolor/256x256/apps/com.github.supercamel.rfdtool.png"
    ],
    "nsis_options": {
      "icon": "images/rfdtool.ico"
    }
  },
  "compile_scripts": false,
  "target": "all",
  "files": [
    "images/com.github.supercamel.rfdtool.png=usr/share/sqgi/app/images/com.github.supercamel.rfdtool.png"
  ]
}
