{
  "name": "RFDTool",
  "script": "main.nut",
  "target": "appimage",
  "sqgi_source": {
    "repo": "https://github.com/supercamel/sqgi.git",
    "ref": "31758c2f5eb5c43d893e687ac615bc139adff470"
  },
  "native_projects": [
    {
      "name": "gserial",
      "repo": "https://github.com/supercamel/gserial.git",
      "dir": ".sqgipkg/native/gserial",
      "branch": "master",
      "update": true,
      "build": [
        "meson setup build --wipe || meson setup build",
        "meson compile -C build"
      ],
      "libraries": [
        "build/libgserial-1.0.so"
      ],
      "typelibs": [
        "build/GSerial-1.0.typelib"
      ]
    }
  ],
  "linux": {
    "arches": [
      {
        "arch": "x86_64",
        "build_dir": "build-linux-x86_64",
        "inherit_native_projects": false,
        "deb": {
          "download": true,
          "suite": "jammy",
          "packages": [
            "libgtk-4-1",
            "gir1.2-gtk-4.0",
            "libglib2.0-0",
            "libgirepository-1.0-1",
            "libharfbuzz-gobject0"
          ]
        },
        "build": [
          "cmake -E rm -rf \"$SQGI_LINUX_BUILD_DIR\"",
          "cmake -S \"$SQGI_SOURCE_DIR\" -B \"$SQGI_LINUX_BUILD_DIR\" -G Ninja ${SQGI_LINUX_CMAKE_TOOLCHAIN:+-DCMAKE_TOOLCHAIN_FILE=\"$SQGI_LINUX_CMAKE_TOOLCHAIN\"} -DCMAKE_BUILD_TYPE=Release -DSQ_ENABLE_JIT=ON",
          "cmake --build \"$SQGI_LINUX_BUILD_DIR\""
        ],
        "native_projects": [
          {
            "name": "gserial",
            "repo": "https://github.com/supercamel/gserial.git",
            "dir": ".sqgipkg/native/gserial",
            "branch": "master",
            "update": true,
            "build": [
              "meson setup build-linux-x86_64 ${SQGI_LINUX_MESON_CROSS_FILE:+--cross-file \"$SQGI_LINUX_MESON_CROSS_FILE\"} --wipe || meson setup build-linux-x86_64 ${SQGI_LINUX_MESON_CROSS_FILE:+--cross-file \"$SQGI_LINUX_MESON_CROSS_FILE\"}",
              "meson compile -C build-linux-x86_64"
            ],
            "libraries": [
              "build-linux-x86_64/libgserial-1.0.so"
            ],
            "typelibs": [
              "build-linux-x86_64/GSerial-1.0.typelib"
            ]
          }
        ]
      },
      {
        "arch": "aarch64",
        "build_dir": "build-linux-aarch64",
        "inherit_native_projects": false,
        "deb": {
          "download": true,
          "suite": "jammy",
          "packages": [
            "libgtk-4-1",
            "gir1.2-gtk-4.0",
            "libglib2.0-0",
            "libgirepository-1.0-1",
            "libharfbuzz-gobject0"
          ]
        },
        "build": [
          "cmake -E rm -rf \"$SQGI_LINUX_BUILD_DIR\"",
          "cmake -S \"$SQGI_SOURCE_DIR\" -B \"$SQGI_LINUX_BUILD_DIR\" -G Ninja ${SQGI_LINUX_CMAKE_TOOLCHAIN:+-DCMAKE_TOOLCHAIN_FILE=\"$SQGI_LINUX_CMAKE_TOOLCHAIN\"} -DCMAKE_BUILD_TYPE=Release -DSQ_ENABLE_JIT=ON",
          "cmake --build \"$SQGI_LINUX_BUILD_DIR\""
        ],
        "native_projects": [
          {
            "name": "gserial",
            "repo": "https://github.com/supercamel/gserial.git",
            "dir": ".sqgipkg/native/gserial",
            "branch": "master",
            "update": true,
            "build": [
              "env -i PATH=/usr/bin:/bin HOME=\"$HOME\" meson setup build-host --wipe || env -i PATH=/usr/bin:/bin HOME=\"$HOME\" meson setup build-host",
              "env -i PATH=/usr/bin:/bin HOME=\"$HOME\" meson compile -C build-host",
              "sh ../../../scripts/disable-cross-gir.sh meson.build",
              "meson setup build-linux-aarch64 ${SQGI_LINUX_MESON_CROSS_FILE:+--cross-file \"$SQGI_LINUX_MESON_CROSS_FILE\"} --wipe || meson setup build-linux-aarch64 ${SQGI_LINUX_MESON_CROSS_FILE:+--cross-file \"$SQGI_LINUX_MESON_CROSS_FILE\"}",
              "meson compile -C build-linux-aarch64"
            ],
            "libraries": [
              "build-linux-aarch64/libgserial-1.0.so"
            ],
            "typelibs": [
              "build-host/GSerial-1.0.typelib"
            ]
          }
        ]
      }
    ]
  },
  "windows": {
    "msys2_prefix": "mingw64",
    "gdk_backend": "win32",
    "build_dir": "build-windows-x86_64",
    "packages": [
    ],
    "build": [
      "cmake -E rm -rf \"$SQGI_WINDOWS_BUILD_DIR\"",
      "cmake -S \"$SQGI_SOURCE_DIR\" -B \"$SQGI_WINDOWS_BUILD_DIR\" -G Ninja -DCMAKE_TOOLCHAIN_FILE=\"$SQGI_WIN_CMAKE_TOOLCHAIN\" -DCMAKE_BUILD_TYPE=Release -DSQ_ENABLE_JIT=ON",
      "cmake --build \"$SQGI_WINDOWS_BUILD_DIR\" --target sqgi sqgi-bin"
    ],
    "native_projects": [
      {
        "name": "gserial",
        "repo": "https://github.com/supercamel/gserial.git",
        "dir": ".sqgipkg/native/gserial",
        "branch": "master",
        "update": true,
        "build": [
          "sh ../../../scripts/disable-cross-gir.sh meson.build",
          "meson setup build-windows --wipe --cross-file \"$SQGI_MESON_CROSS_FILE\" || meson setup build-windows --cross-file \"$SQGI_MESON_CROSS_FILE\"",
          "meson compile -C build-windows",
          "env -i PATH=/usr/bin:/bin HOME=\"$HOME\" meson setup build-host --wipe || env -i PATH=/usr/bin:/bin HOME=\"$HOME\" meson setup build-host",
          "env -i PATH=/usr/bin:/bin HOME=\"$HOME\" meson compile -C build-host"
        ],
        "libraries": [
          "build-windows/libgserial-1.0.dll"
        ],
        "typelibs": [
          "build-host/GSerial-1.0.typelib"
        ]
      }
    ]
  }
}
